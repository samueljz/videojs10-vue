{
  "name": "videojs10-vue",
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://github.com/samueljz/videojs10-vue",
  "main": "./dist/videojs10-vue.umd.cjs",
  "module": "./dist/videojs10-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/videojs10-vue.js",
      "require": "./dist/videojs10-vue.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/videojs10-vue.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:web": "run-p type-check \"build-only:web {@}\" --",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.ts --outDir dist-web",
    "build-only": "vite build",
    "build-only:web": "vite build --config vite.config.web.ts",
    "type-check": "vue-tsc --build",
    "predeploy": "npm run build-only:web",
    "deploy": "gh-pages -d dist-web"
  },
  "peerDependencies": {
    "@videojs/html": "^10.0.0-beta.32",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@videojs/html": "^10.0.0-beta.32",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
